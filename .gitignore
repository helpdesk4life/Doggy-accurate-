# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
*.iml
*.apk
*.aab

# Written by `./gradlew :app:dependencies --write-locks` next to the real
# android/app/gradle.lockfile. It only records version-catalog resolution and
# is not scanned, so keep it out of the tree.
android/settings-gradle.lockfile

# Python
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
*.pyc

# OS
.DS_Store
Thumbs.db

# Release signing (never commit)
android/keystore.properties
*.jks
*.keystore

# Runtime secrets. backend/.env on the VPS holds JWT_SECRET, which is the one
# value that makes every token in the deployment forgeable.
#
# `.env.*` is not redundant with `.env`: a bare `.env` pattern matches only that
# exact name, so the `.env.bak-*` copies made during a secret rotation stayed
# untracked-but-committable. Three of them sat in the VPS working tree holding
# JWT_SECRET and SMTP_PASSWORD, one `git add -A` from the repository.
.env
.env.*
!.env.example
