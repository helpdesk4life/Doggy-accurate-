<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only transport affordances.

    Cleartext stays enabled so the emulator can still talk to a plain ws://
    backend, and the network security config adds Caddy's local CA so the
    wss:// path works too. Release builds inherit the main manifest, which sets
    neither, so they can only reach a publicly trusted wss:// endpoint.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true" />

</manifest>
